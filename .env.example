# Paste your own free API keys after the = sign (no quotes, no spaces)
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
LLM_API_KEY=

# Folder with the PDFs. Relative to this app folder, or a full path like C:\Data\Coastal_Noakhali
PDF_DIR=Coastal_Noakhali

# Models, tried in order, as provider:model (providers: groq, openrouter)
# Writing the final answer:
LLM_MODELS=groq:qwen/qwen3.8-27b,openrouter:inclusionai/ling-3.0-flash-sante:free,groq:openai/gpt-oss-120b
# Small helper steps of the RAG graph (router, grade, rewrite, check):
LLM_MODELS_FAST=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,openrouter:inclusionai/ling-3.0-flash-sante:free
# Writing SQL for count/total questions:
LLM_MODELS_SQL=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
